{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the video or series"
    },
    "description": {
      "type": "string",
      "description": "Short description"
    },
    "video_type": {
      "type": "string",
      "enum": [
        "youtube",
        "drive_folder",
        "mp3"
      ],
      "description": "Type of video content"
    },
    "youtube_url": {
      "type": "string",
      "description": "YouTube video URL"
    },
    "drive_folder_url": {
      "type": "string",
      "description": "Google Drive folder URL (for anime/series episodes)"
    },
    "mp3_url": {
      "type": "string",
      "description": "Uploaded MP3 file URL"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Optional thumbnail image URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "anime",
        "movie",
        "series",
        "music",
        "other"
      ],
      "default": "other",
      "description": "Content category"
    }
  },
  "required": [
    "title",
    "video_type"
  ]
}