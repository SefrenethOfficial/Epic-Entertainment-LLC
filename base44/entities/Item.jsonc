{
  "name": "Item",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "description": "Name of the item"
    },
    "icon_url": {
      "type": "string",
      "description": "Image URL for the item icon"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary"
      ],
      "default": "common",
      "description": "Rarity tier of the item"
    },
    "worth": {
      "type": "number",
      "default": 0,
      "description": "Worth in points when sold at the jeweler"
    }
  },
  "required": [
    "item_name",
    "icon_url"
  ]
}