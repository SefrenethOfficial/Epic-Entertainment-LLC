{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID of the owner"
    },
    "user_email": {
      "type": "string",
      "description": "User email of the owner"
    },
    "display_name": {
      "type": "string",
      "description": "Display name of the owner at time of acquisition"
    },
    "item_id": {
      "type": "string",
      "description": "Reference to the Item entity"
    },
    "item_name": {
      "type": "string",
      "description": "Snapshot of item name"
    },
    "item_icon_url": {
      "type": "string",
      "description": "Snapshot of item icon URL"
    },
    "item_rarity": {
      "type": "string",
      "description": "Snapshot of item rarity"
    },
    "item_worth": {
      "type": "number",
      "default": 0,
      "description": "Snapshot of item worth in points"
    }
  },
  "required": [
    "user_id",
    "item_name"
  ]
}